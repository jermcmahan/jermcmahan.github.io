{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class = "footer-social-icons">
          {% include social.liquid %}
      </div>

      <div>
          {{footer_contents}}
      </div>
    </div>
  </footer>
{% endif %}

<style>
  /* Force the list inside our footer-social-icons to display horizontally */
  .footer-social-icons ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: inline-block;
  }
  .footer-social-icons li {
    display: inline-block;
    padding: 0 25px; /* Adjust spacing between icons here */
  }
  
  /* Icon styling: Grey -> Theme Color */
  .footer-social-icons a {
    color: #000000 !important;
    font-size: 2rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-social-icons a:hover {
    color: var(--global-theme-color) !important; /* Moss Green */
  }
</style>